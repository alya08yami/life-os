# Server only. Never put provider keys in EXPO_PUBLIC variables.
# Choose a model enabled for your own account. Rates must be explicitly configured.
OPENAI_API_KEY=
LIFE_OS_AI_MODEL=
LIFE_OS_AI_INPUT_USD_PER_MILLION=
LIFE_OS_AI_OUTPUT_USD_PER_MILLION=
LIFE_OS_AI_DAILY_MICRO_USD=1000000
LIFE_OS_AI_DAILY_REQUESTS=10
TMDB_READ_ACCESS_TOKEN=
# Optional: otherwise generated in .local/server-setup-code, permissions 0600.
LIFE_OS_SETUP_CODE=
# Native clients only: point to your own HTTPS API deployment (not a provider URL).
# EXPO_PUBLIC_API_URL=https://your-own-api.example

# Server-only Google Places API (New), optional; photos are shown transiently with attribution.
GOOGLE_PLACES_API_KEY=
