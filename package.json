{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node scripts/expo.cjs start",
    "web": "node scripts/expo.cjs start --web",
    "preview": "node scripts/preview.cjs",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/expo.cjs export --platform web",
    "server": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "build:pages": "node scripts/build-pages.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "fake-indexeddb": "^6.2.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
